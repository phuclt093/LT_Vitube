# Chép thành .env rồi sửa. File .env không đưa lên git.

# Địa chỉ HTTPS công khai của vitube (Tailscale hoặc tên miền Cloudflare)
VITUBE_PUBLIC_URL=https://vitube.ten-mien-cua-ban.com

# Cloudflare Tunnel có tên — lấy ở dash.cloudflare.com → Zero Trust → Networks → Tunnels
# → Create a tunnel → Docker → copy chuỗi token. Trong tunnel đó thêm Public Hostname
# trỏ tới  http://vitube:3000
TUNNEL_TOKEN=

# Máy chủ thuê (VPS, Oracle…) hay bị YouTube hỏi "Sign in to confirm you're not a bot".
# Xuất cookie YouTube từ trình duyệt ra cookies/cookies.txt rồi bật dòng dưới.
# YTDLP_COOKIES_FILE=/cookies/cookies.txt

# yt-dlp bản mới cần một trình chạy JavaScript để giải mã YouTube. Image đã có sẵn Node;
# nếu log báo thiếu "JavaScript runtime" thì bật dòng dưới.
# YTDLP_ARGS=--js-runtimes node

# Sau khi build APK Android (android/build-apk.sh in ra giá trị này)
# TWA_SHA256=
