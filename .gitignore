# ---- Log ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# san pham build cua app desktop
vitube-desktop/resources/
vitube-desktop/release/

# Icon app: `build/` o tren bi chan (danh cho thu muc build cua Gradle/Next),
# nhung vitube-desktop/build/ la thu muc TAI NGUYEN cua electron-builder — mat no
# thi ban dong goi quay ve icon Electron mac dinh.
!vitube-desktop/build/
!vitube-desktop/build/icon.svg
!vitube-desktop/build/icon.png
!vitube-desktop/build/icon.ico

# virtualenv Python cho yt-dlp worker
.venv/

# ---- vitube_PWA ----
