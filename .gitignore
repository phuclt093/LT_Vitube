# ---- Source tham khảo, không đưa lên repo ----
YMusic-Youtube-Multilingual-Music-Player-for-Android-master/
YMusic-Youtube-Multilingual-Music-Player-for-Android-master.zip

# ---- Node / Next.js ----
# nơi build:pages tạm cất route API — tự dọn sau mỗi lần build
.pages-stash/
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ---- Biến môi trường & dữ liệu ----
.env
.env.local
.env.*.local
# Chỉ thư mục dữ liệu của server (SQLite, cache luồng) — KHÔNG được viết trần
# `data/`: như thế là bỏ qua MỌI thư mục tên data, kể cả mã nguồn
# vitube-tv/core/src/main/java/com/vitube/core/data/ (Api.kt, Settings.kt…).
# Dòng trần đó đã làm thư mục mã nguồn này chưa bao giờ lên được git.
/data/
vitube-web/data/
vitube-desktop/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# ---- yt-dlp tải về ----
vitube-web/bin/*
!vitube-web/bin/.gitkeep

# ---- Android ----
.gradle/
local.properties
*.apk
*.aab
*.keystore
*.jks
captures/
.cxx/
app/release/

